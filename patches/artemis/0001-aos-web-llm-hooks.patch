index 0000000..8be750a
--- /dev/null
+++ b/artemis/security/install.py
@@ -0,0 +1,244 @@
+# Copyright 2026 Google LLC
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     https://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""PATCH (aos-mcp): install web-LLM redaction/injection hooks into ARTEMIS.
+
+Loaded from ``mcp_server/__main__.py`` when ``AOS_LLM_HOOKS=1``. Every hook is
+best-effort at import time but *fail-closed*: if the hook module cannot load,
+Python startup raises and the ARTEMIS child fails instead of running without
+redaction.
+"""
+
+from __future__ import annotations
+
+import functools
+import os
+from typing import Any
+
+from .redaction import (
+    hooks_enabled,
+    redact_screen_data,
+    redact_structure,
+    redact_text,
+    resolve_text,
+)
+
+_installed = False
+
+
+def _redact_content(content: Any) -> Any:
+    if isinstance(content, str):
+        return redact_text(content)
+    if isinstance(content, list):
+        return [_redact_content(item) for item in content]
+    if isinstance(content, dict):
+        return {
+            key: (value if key in ("image_url", "image") else _redact_content(value))
+            for key, value in content.items()
+        }
+    return content
+
+
+def _redact_message(value: Any) -> Any:
+    content = getattr(value, "content", None)
+    if content is None:
+        return redact_structure(value)
+    redacted = _redact_content(content)
+    if redacted == content:
+        return value
+    if hasattr(value, "model_copy"):
+        return value.model_copy(update={"content": redacted})
+    if hasattr(value, "copy"):
+        return value.copy(update={"content": redacted})
+    return value
+
+
+def _redact_call_args(args: tuple[Any, ...], kwargs: dict[str, Any]) -> tuple[tuple[Any, ...], dict[str, Any]]:
+    return (
+        tuple(_redact_message(arg) for arg in args),
+        {key: _redact_message(value) for key, value in kwargs.items()},
+    )
+
+
+def _redact_arg(value: Any) -> Any:
+    fields = getattr(value, "model_fields", None)
+    if isinstance(fields, dict) and hasattr(value, "model_copy"):
+        updates = {
+            name: redact_structure(getattr(value, name))
+            for name in fields
+            if hasattr(value, name)
+        }
+        return value.model_copy(update=updates)
+    return redact_structure(value)
+
+
+class _RedactingChatModel:
+    """Duck-typed wrapper for direct `get_google_llm`/ModelFactory paths."""
+
+    def __init__(self, inner: Any):
+        self._inner = inner
+
+    def __getattr__(self, name: str) -> Any:
+        return getattr(self._inner, name)
+
+    def _wrap(self, value: Any) -> Any:
+        return value if value is self._inner else _RedactingChatModel(value)
+
+    def bind_tools(self, *args: Any, **kwargs: Any) -> Any:
+        return self._wrap(self._inner.bind_tools(*args, **kwargs))
+
+    def with_config(self, *args: Any, **kwargs: Any) -> Any:
+        return self._wrap(self._inner.with_config(*args, **kwargs))
+
+    def with_structured_output(self, *args: Any, **kwargs: Any) -> Any:
+        return self._wrap(self._inner.with_structured_output(*args, **kwargs))
+
+    def invoke(self, *args: Any, **kwargs: Any) -> Any:
+        args, kwargs = _redact_call_args(args, kwargs)
+        return self._inner.invoke(*args, **kwargs)
+
+    async def ainvoke(self, *args: Any, **kwargs: Any) -> Any:
+        args, kwargs = _redact_call_args(args, kwargs)
+        return await self._inner.ainvoke(*args, **kwargs)
+
+    async def astream(self, *args: Any, **kwargs: Any) -> Any:
+        args, kwargs = _redact_call_args(args, kwargs)
+        async for chunk in self._inner.astream(*args, **kwargs):
+            yield chunk
+
+
+def _patch_llm() -> None:
+    from artemis.services import llm as llm_module
+
+    wrapper = getattr(llm_module, "RobustChatModelWrapper", None)
+    if wrapper is not None and not getattr(wrapper, "_aos_redacted", False):
+        original = wrapper._complete_attempt
+
+        @functools.wraps(original)
+        async def complete(self: Any, emit_deltas: bool, *args: Any, **kwargs: Any) -> Any:
+            args, kwargs = _redact_call_args(args, kwargs)
+            return await original(self, emit_deltas, *args, **kwargs)
+
+        wrapper._complete_attempt = complete
+        wrapper._aos_redacted = True
+
+    original_google = getattr(llm_module, "get_google_llm", None)
+    if original_google is not None and not getattr(original_google, "_aos_redacted", False):
+        @functools.wraps(original_google)
+        def get_google_llm(*args: Any, **kwargs: Any) -> Any:
+            return _RedactingChatModel(original_google(*args, **kwargs))
+
+        get_google_llm._aos_redacted = True  # type: ignore[attr-defined]
+        llm_module.get_google_llm = get_google_llm
+
+
+def _patch_screen() -> None:
+    from artemis.drivers.android.adb_driver import AndroidAdbDriver
+    from artemis.drivers.cloud.cloud_driver import CloudDeviceDriver
+
+    def wrap_screen(original: Any) -> Any:
+        @functools.wraps(original)
+        async def get_screen_data(self: Any, *args: Any, **kwargs: Any) -> Any:
+            data = await original(self, *args, **kwargs)
+            return redact_screen_data(data)
+
+        get_screen_data._aos_masked = True  # type: ignore[attr-defined]
+        return get_screen_data
+
+    for cls in (AndroidAdbDriver, CloudDeviceDriver):
+        original = getattr(cls, "get_screen_data", None)
+        if original is None or getattr(original, "_aos_masked", False):
+            continue
+        cls.get_screen_data = wrap_screen(original)
+
+
+def _patch_actions() -> None:
+    from artemis.drivers.android.adb_driver import AndroidAdbDriver
+    from artemis.drivers.android.input_ime import AndroidInputIME
+    from artemis.drivers.cloud.cloud_driver import CloudDeviceDriver
+
+    def wrap_input(original: Any) -> Any:
+        @functools.wraps(original)
+        async def input_text(self: Any, text: str, *args: Any, **kwargs: Any) -> Any:
+            return await original(self, resolve_text(text), *args, **kwargs)
+
+        input_text._aos_resolved = True  # type: ignore[attr-defined]
+        return input_text
+
+    for cls in (AndroidAdbDriver, AndroidInputIME, CloudDeviceDriver):
+        for name in ("input_text", "type_text"):
+            original = getattr(cls, name, None)
+            if original is None or getattr(original, "_aos_resolved", False):
+                continue
+            setattr(cls, name, wrap_input(original))
+
+
+def _patch_storage() -> None:
+    from artemis.data_engine.storage import StorageManager
+
+    def wrap_storage(original: Any) -> Any:
+        @functools.wraps(original)
+        def method(self: Any, *args: Any, **kwargs: Any) -> Any:
+            redacted_args = tuple(_redact_arg(arg) for arg in args)
+            redacted_kwargs = {key: _redact_arg(value) for key, value in kwargs.items()}
+            return original(self, *redacted_args, **redacted_kwargs)
+
+        method._aos_redacted = True  # type: ignore[attr-defined]
+        return method
+
+    for name in (
+        "create_step",
+        "update_step_action",
+        "update_step_summary",
+        "update_step_thinking",
+        "update_step_native_thinking",
+        "update_step_execution_result",
+        "create_image",
+        "update_image_data",
+    ):
+        original = getattr(StorageManager, name, None)
+        if original is None or getattr(original, "_aos_redacted", False):
+            continue
+        setattr(StorageManager, name, wrap_storage(original))
+
+
+def _patch_trace() -> None:
+    from artemis.runtime import trace_store
+
+    original = getattr(trace_store, "update_trace_status", None)
+    if original is None or getattr(original, "_aos_redacted", False):
+        return
+
+    @functools.wraps(original)
+    def update_trace_status(*args: Any, **kwargs: Any) -> Any:
+        if "error" in kwargs:
+            kwargs["error"] = redact_text(kwargs["error"]) if isinstance(kwargs["error"], str) else kwargs["error"]
+        if "result" in kwargs:
+            kwargs["result"] = redact_structure(kwargs["result"])
+        return original(*args, **kwargs)
+
+    update_trace_status._aos_redacted = True  # type: ignore[attr-defined]
+    trace_store.update_trace_status = update_trace_status
+
+
+def install() -> None:
+    global _installed
+    if _installed or not hooks_enabled():
+        return
+    _installed = True
+    _patch_llm()
+    _patch_screen()
+    _patch_actions()
+    _patch_storage()
+    _patch_trace()
