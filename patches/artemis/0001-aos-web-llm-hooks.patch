+# limitations under the License.
+
+"""PATCH (aos-mcp): project-scoped secret redaction/injection for web LLM runs.
+
+The hooks are only active when ``AOS_LLM_HOOKS=1``. Secret values live in the
+0600 JSON file named by ``AOS_LLM_SECRET_FILE``; the file is read lazily and
+reloaded when its mtime changes so a long-lived ARTEMIS process sees updates.
+"""
+
+from __future__ import annotations
+
+import base64
+import io
+import json
+import os
+import re
+import threading
+import time
+from pathlib import Path
+from typing import Any
+
+from PIL import Image, ImageDraw
+
+SECRET_FILE_ENV = "AOS_LLM_SECRET_FILE"
+STRICT_ENV = "AOS_LLM_HOOKS_STRICT"
+HOOKS_ENV = "AOS_LLM_HOOKS"
+
+_ACCOUNT_PATTERNS = [
+    re.compile(r"[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}"),
+    re.compile(r"\+?\d[\d\s-]{6,}\d"),
+    re.compile(r"\beyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\b"),
+]
+
+
+class SecretStore:
+    def __init__(self) -> None:
+        self._lock = threading.Lock()
+        self._path: str | None = None
+        self._mtime: float | None = None
+        self._entries: dict[str, str] = {}
+
+    def _load(self) -> dict[str, str]:
+        path = (os.environ.get(SECRET_FILE_ENV) or "").strip()
+        if path == "":
+            return {}
+        try:
+            mtime = os.path.getmtime(path)
+        except OSError:
+            return {}
+        with self._lock:
+            if self._path == path and self._mtime == mtime:
+                return self._entries
+            try:
+                raw = Path(path).read_text(encoding="utf-8")
+                parsed = json.loads(raw)
+            except (OSError, ValueError):
+                parsed = {}
+            entries = {
+                str(alias): str(value)
+                for alias, value in (parsed.items() if isinstance(parsed, dict) else [])
+                if str(alias).strip() != "" and str(value).strip() != ""
+            }
+            self._path = path
+            self._mtime = mtime
+            self._entries = entries
+            return entries
+
+    def entries(self) -> dict[str, str]:
+        return self._load()
+
+    def values(self) -> list[str]:
+        return sorted(self._load().values(), key=len, reverse=True)
+
+
+_store = SecretStore()
+
+
+def hooks_enabled() -> bool:
+    return os.environ.get(HOOKS_ENV) == "1"
+
+
+def strict_mode() -> bool:
+    return os.environ.get(STRICT_ENV, "1") != "0"
+
+
+def _redact_patterns(text: str) -> str:
+    result = text
+    for pattern in _ACCOUNT_PATTERNS:
+        result = pattern.sub("<redacted>", result)
+    return result
+
+
+def redact_text(text: str) -> str:
+    if not hooks_enabled() or not isinstance(text, str) or text == "":
+        return text
+    result = text
+    for value in _store.values():
+        if len(value) >= 3:
+            result = result.replace(value, "<redacted>")
+    return _redact_patterns(result)
+
+
+def resolve_text(text: str) -> str:
+    if not hooks_enabled() or not isinstance(text, str) or text == "":
+        return text
+    result = text
+    for alias, value in _store.entries().items():
+        result = result.replace(f"<secret:{alias}>", value)
+    return result
+
+
+def redact_structure(value: Any) -> Any:
+    if not hooks_enabled():
+        return value
+    if isinstance(value, str):
+        return redact_text(value)
+    if isinstance(value, list):
+        return [redact_structure(item) for item in value]
+    if isinstance(value, tuple):
+        return tuple(redact_structure(item) for item in value)
+    if isinstance(value, dict):
+        return {key: redact_structure(item) for key, item in value.items()}
+    return value
+
+
+def _bounds_of(element: dict[str, Any]) -> tuple[int, int, int, int] | None:
+    bounds = element.get("bounds")
+    if isinstance(bounds, (list, tuple)) and len(bounds) == 4:
+        try:
+            return tuple(int(part) for part in bounds)  # type: ignore[return-value]
+        except (TypeError, ValueError):
+            return None
+    parsed = element.get("parsed_bounds")
+    if isinstance(parsed, dict):
+        try:
+            return (
+                int(parsed.get("left", 0)),
+                int(parsed.get("top", 0)),
+                int(parsed.get("right", 0)),
+                int(parsed.get("bottom", 0)),
+            )
+        except (TypeError, ValueError):
+            return None
+    return None
+
+
+def _element_text(element: dict[str, Any]) -> str:
+    parts: list[str] = []
+    for key in ("text", "content-desc", "contentDescription", "hint"):
+        value = element.get(key)
+        if isinstance(value, str) and value.strip() != "":
+            parts.append(value)
+    return " ".join(parts)
+
+
+def _sensitive(text: str) -> bool:
+    if text.strip() == "":
+        return False
+    if redact_text(text) != text:
+        return True
+    return any(pattern.search(text) for pattern in _ACCOUNT_PATTERNS)
+
+
+def redact_elements(elements: list[dict[str, Any]]) -> list[dict[str, Any]]:
+    return [redact_structure(element) for element in elements]
+
+
+def mask_screenshot(
+    screenshot_bytes: bytes,
+    elements: list[dict[str, Any]],
+) -> bytes:
+    if not hooks_enabled() or not screenshot_bytes or not elements:
+        return screenshot_bytes
+    try:
+        image = Image.open(io.BytesIO(screenshot_bytes)).convert("RGB")
+    except Exception:
+        return screenshot_bytes
+    draw = ImageDraw.Draw(image)
+    changed = False
+    for element in elements:
+        if not _sensitive(_element_text(element)):
+            continue
+        bounds = _bounds_of(element)
+        if bounds is None:
+            continue
+        left, top, right, bottom = bounds
+        if right <= left or bottom <= top:
+            continue
+        draw.rectangle([left, top, right, bottom], fill=(0, 0, 0))
+        changed = True
+    if not changed:
+        return screenshot_bytes
+    buffer = io.BytesIO()
+    image.save(buffer, format="PNG")
+    return buffer.getvalue()
+
+
+def redact_screen_data(screen_data: Any) -> Any:
+    if not hooks_enabled() or screen_data is None:
+        return screen_data
+    elements = getattr(screen_data, "ui_elements", None)
+    if not isinstance(elements, list):
+        elements = []
+    masked = mask_screenshot(getattr(screen_data, "screenshot_bytes", b"") or b"", elements)
+    masked64 = (
+        base64.b64encode(masked).decode("utf-8") if masked else getattr(screen_data, "screenshot_base64", "")
+    )
+    xml = redact_text(getattr(screen_data, "ui_hierarchy_xml", "") or "")
+    update = {
+        "screenshot_bytes": masked,
+        "screenshot_base64": masked64,
+        "ui_hierarchy_xml": xml,
+        "ui_elements": redact_elements([item for item in elements if isinstance(item, dict)]),
+    }
+    if hasattr(screen_data, "model_copy"):
+        return screen_data.model_copy(update=update)
+    if hasattr(screen_data, "copy"):
+        return screen_data.copy(update=update)
+    return screen_data
+
+
+def redact_trace_result(value: Any) -> Any:
+    return redact_structure(value)
+
+
+def redact_file_in_place(path: str) -> None:
+    if not hooks_enabled() or not path or not os.path.exists(path):
+        return
+    try:
+        raw = Path(path).read_text(encoding="utf-8")
+        redacted = redact_text(raw)
+        if redacted != raw:
+            Path(path).write_text(redacted, encoding="utf-8")
+    except OSError:
+        return
