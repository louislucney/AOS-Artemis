+
+"""PATCH (aos-mcp): tests for web LLM redaction hooks."""
+
+from __future__ import annotations
+
+import base64
+import io
+import json
+from pathlib import Path
+
+from PIL import Image
+
+from artemis.security.redaction import (
+    mask_screenshot,
+    redact_text,
+    resolve_text,
+)
+
+
+def _secret_file(tmp_path: Path) -> Path:
+    path = tmp_path / "secrets.json"
+    path.write_text(
+        json.dumps({"account": "user@example.com", "password": "p@ssw0rd"}),
+        encoding="utf-8",
+    )
+    return path
+
+
+def test_redact_and_resolve(monkeypatch, tmp_path):
+    monkeypatch.setenv("AOS_LLM_HOOKS", "1")
+    monkeypatch.setenv("AOS_LLM_SECRET_FILE", str(_secret_file(tmp_path)))
+    text = "账号 user@example.com 密码 p@ssw0rd"
+    assert "user@example.com" not in redact_text(text)
+    assert "p@ssw0rd" not in redact_text(text)
+    assert resolve_text("<secret:account>") == "user@example.com"
