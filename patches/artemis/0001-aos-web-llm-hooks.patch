@@ -8,6 +8,8 @@ keep the `PATCH (aos-mcp)` markers.
 
 - `artemis/security/redaction.py` — project-scoped secret inventory,
   text redaction, screenshot masking by UI bounds, placeholder resolution.
+  Missing bounds on any sensitive node invalidates the whole screenshot
+  (drop/blur/none per `AOS_LLM_REDACT_IMAGE_FALLBACK`).
 - `artemis/security/install.py` — runtime hooks for:
   - `RobustChatModelWrapper._complete_attempt` (LLM message text redaction)
   - `get_google_llm` direct-call wrapper
@@ -21,3 +23,16 @@ keep the `PATCH (aos-mcp)` markers.
 Activation: `AOS_LLM_HOOKS=1`; secret map via `AOS_LLM_SECRET_FILE` (0600 JSON).
 When hooks are disabled or cannot load, AOS fails closed for secret-bearing
 web LLM cases.
+
+## 2026-11-10 · non-Google provider hard redirect
+
+- `artemis/security/install.py` — when `AOS_LLM_REDIRECT_GOOGLE=1`:
+  - `get_google_llm` returns an OpenAI-compatible `ChatOpenAI` pointed at
+    `OPENAI_BASE_URL` / `AOS_LLM_MODEL` (covers memory capsules, summarizer
+    fallbacks and direct-call helpers);
+  - `lightweight_judge_default` returns the active provider/model instead of
+    the upstream Google default (validator pixel safety net / planner
+    validation).
+- AOS sets this only for non-Google entries; Google entries keep upstream
+  behavior. `GOOGLE_API_KEY`/`GEMINI_API_KEY` are cleared in the child env so
+  native `genai` paths cannot silently use Gemini.
diff --git a/artemis/security/install.py b/artemis/security/install.py
index 75ba29d..9fa9038 100644
--- a/artemis/security/install.py
+++ b/artemis/security/install.py
@@ -246,11 +246,63 @@ def _patch_trace() -> None:
     trace_store.update_trace_status = update_trace_status
 
 
+def _patch_llm_redirect() -> None:
+    """PATCH (aos-mcp): route upstream Google-only helpers to the active LLM.
+
+    Artemis still has a few hard-coded ``get_google_llm``/lightweight-judge
+    paths (memory capsules, summarizer fallbacks, validator safety net). On a
+    non-Google provider AOS sets ``AOS_LLM_REDIRECT_GOOGLE=1``; return an
+    OpenAI-compatible client pointed at the center proxy instead of letting
+    those paths call Gemini without a key.
+    """
+    from artemis.services import llm as llm_module
+
+    original = getattr(llm_module, "get_google_llm", None)
+    if original is not None and not getattr(original, "_aos_redirected", False):
+        @functools.wraps(original)
+        def get_google_llm(*args: Any, **kwargs: Any) -> Any:
+            from langchain_openai import ChatOpenAI
+
+            model = os.environ.get("AOS_LLM_MODEL") or "deepseek-flash"
+            return ChatOpenAI(
+                model=model,
+                base_url=os.environ.get("OPENAI_BASE_URL") or None,
+                api_key=os.environ.get("OPENAI_API_KEY") or "EMPTY",
+                temperature=float(kwargs.get("temperature", 0.0) or 0.0),
+            )
+
+        get_google_llm._aos_redirected = True  # type: ignore[attr-defined]
+        llm_module.get_google_llm = get_google_llm
+
+    from artemis.config import llm as config_llm
+
+    judge = getattr(config_llm, "lightweight_judge_default", None)
+    if judge is not None and not getattr(judge, "_aos_redirected", False):
+        @functools.wraps(judge)
+        def lightweight_judge_default() -> Any:
+            provider = os.environ.get("AOS_LLM_PROVIDER") or "custom"
+            model = os.environ.get("AOS_LLM_MODEL") or "deepseek-flash"
+            fallback = config_llm.LLM(provider=provider, model=model, temperature=0.0)
+            return config_llm.LLMWithFallback(
+                provider=provider,
+                model=model,
+                temperature=0.0,
+                fallback=fallback,
+            )
+
+        lightweight_judge_default._aos_redirected = True  # type: ignore[attr-defined]
+        config_llm.lightweight_judge_default = lightweight_judge_default
+
+
 def install() -> None:
     global _installed
-    if _installed or not hooks_enabled():
+    if _installed:
         return
     _installed = True
+    if os.environ.get("AOS_LLM_REDIRECT_GOOGLE") == "1":
+        _patch_llm_redirect()
+    if not hooks_enabled():
+        return
     _patch_llm()
     _patch_screen()
     _patch_actions()
