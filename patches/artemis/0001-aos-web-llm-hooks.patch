+def test_mask_screenshot_mixed_missing_bounds_fails_closed(monkeypatch, tmp_path):
+    monkeypatch.setenv("AOS_LLM_HOOKS", "1")
+    monkeypatch.setenv("AOS_LLM_SECRET_FILE", str(_secret_file(tmp_path)))
+    image = Image.new("RGB", (100, 100), "white")
+    buffer = io.BytesIO()
+    image.save(buffer, format="PNG")
+    masked = mask_screenshot(
+        buffer.getvalue(),
+        [
+            {"text": "user@example.com", "bounds": [10, 10, 80, 40]},
+            {"text": "p@ssw0rd"},
+        ],
+    )
+    result = Image.open(io.BytesIO(masked)).convert("RGB")
+    assert result.size == (1, 1)
+    assert result.getpixel((0, 0)) == (0, 0, 0)
+
+
