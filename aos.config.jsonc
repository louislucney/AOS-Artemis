{
  // 【可选高级层】不配置也能工作：
  // 项目 LLM 由 .env（AOS_LLM_*，见 .env.example）或 aos_configure 工具创建，
  // 并持久化到 PostgreSQL。本文件用于多档案精细控制 / nodeOverrides / 固定设备等。
  // 详见 DESIGN.md §4。

  // 项目显示名（台账/面板）；缺省用目录名。
  "project": {
    "name": "mobile-testing"
  },

  "llm": {
    "profiles": {}
  },

  // 同机双端共享设计真源（可选；跨主机不要共享磁盘）。
  // 共享目录只作为 canonical 只读源：里面放 flows.json/acceptance.json 等；
  // 本服务的 tests.json 与运行台账仍写各项目本地。
  // "design": { "sharedDir": "../shared-design" },

  "artemis": {
    // 留空 = 使用服务安装目录旁的 ./artemis（容器内默认）
    "repo": "",
    "mode": "standalone",
    "configDir": ".artemis",
    "deviceSerial": null,
    // 可选：artemis 依赖包地址（scripts/artemis-deps.sh 构建，tar.gz）。
    // venv 缺失时首次运行自动下载并离线安装；env AOS_ARTEMIS_DEPS_URL 优先。
    // "depsUrl": "http://files.internal/aos/artemis-deps-darwin-arm64.tar.gz",
    // "depsSha256": "…"
  }
}
