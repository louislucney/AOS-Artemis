# mobile-testing MCP — 项目级凭证（服务首次启用时扫描导入；也可由 aos_configure 工具自动写入）
# 注意：本文件不要提交到 git。

# LLM：OpenAI 兼容三元组（参考 DeepSeek 用法）
AOS_LLM_NAME=
AOS_LLM_MODEL=deepseek-flash
AOS_LLM_BASE_URL=https://api.deepseek.com/v1
AOS_LLM_API_KEY=

# 兼容旧名（优先级低于 AOS_LLM_*；如项目已有以下变量可直接沿用）
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Figma（可选；仅 REST 模式工具需要）
FIGMA_ACCESS_TOKEN=

# 模型目录（可选）：厂商 /models 列表定时刷新周期（小时，默认 12；0 = 关闭定时）
# AOS_MODEL_REFRESH_HOURS=12
# 模型下线自动修复（默认开启；=0 则只报告，由 mobile_run_task 预检拦截）
# AOS_LLM_AUTO_REPAIR=1

# pen.dev（可选；pen_export / pen_apply_tokens / pen_apply_strings / pen_agent 需要，见 DESIGN.md §6.1）
# CLI 缺失时自动安装到 ~/.aos/pen-cli（Node ≥ 22.19，需网络；AOS_PEN_NO_INSTALL=1 关闭）
# 登录二选一：pen login，或在 pen.dev 组织设置创建 Developer Key 写入本文件（自动透传）
# PEN_CLI_KEY=
# AOS_PEN_CLI_PATH=              # 显式指定 pen 可执行文件（默认：托管目录 → PATH）
# AOS_PEN_CLI_DIR=               # 托管安装目录（默认 ~/.aos/pen-cli）
# AOS_PEN_VERSION=               # 自动安装版本（默认 latest，可固定如 0.3.9）
# AOS_PEN_TIMEOUT_MS=120000      # 单次 CLI 调用超时（5000–600000）
# AOS_PEN_INSTALL_TIMEOUT_MS=600000  # 自动安装超时（60000–1800000）
# pen_agent 凭证自动复用 AOS_LLM_API_KEY；Anthropic 兼容端点自动桥接：
#   DeepSeek（apiKey 头，已实测）/ Kimi·Z.AI·百炼（Bearer + 模型 env，待真实 key 冒烟）
# AOS_PEN_ANTHROPIC_BASE_URL=    # 覆盖 Anthropic 兼容端点（未识别 provider 时使用）

# Jira（可选；读取工具/证据回写/面板一键建单需要，见 DESIGN.md §6.8/§13.111）
# 凭证三件套（推荐用 aos_configure 的 jiraSite/jiraEmail/jiraApiToken 一次写入；三者须同时提供）
# JIRA_BASE_URL=https://your-site.atlassian.net   # 仅接受 https://<site>.atlassian.net
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# 面板「一键建单」缺省值（可选；面板表单输入优先，见 DESIGN.md §13.111）
# JIRA_ISSUE_PROJECT=            # 缺省 Jira 项目 key（面板未填项目时使用；未配置则建单报 400 指引）
# JIRA_ISSUE_TYPE=Bug            # 缺省 issue 类型（默认 Bug）
# JIRA_ISSUE_LABELS=             # 缺省标签（逗号分隔）

# 视觉识别（可选；pen_extract_flows 的 vision 阶段，见 DESIGN.md §13.91/§13.130/§13.133）
# AOS_VISION=0                   # 全局关闭视觉识别
# AOS_VISION_MAX_TARGETS=50      # 单次视觉识别目标上限（主屏+状态变体，默认 50；0/all/unlimited 不限）
# AOS_VISION_MAX_SCREENS=50      # 兼容旧配置：未设 AOS_VISION_MAX_TARGETS 时生效（语义同上，现含变体）
# AOS_VISION_CANDIDATE_TOKENS=   # 追加候选交互元素词表（逗号分隔；默认英文/中文词表始终生效）
# AOS_VISION_CACHE_DAYS=7        # 模型视觉能力探测结论缓存天数（0 关闭缓存）
# AOS_LLM_VISION=1               # 声明 active 模型是否具备视觉能力（1/0，优先于启发式与缓存）

# 崩溃取证（可选；任务终态自动采集设备 crash buffer，见 DESIGN.md §6.5）
# AOS_CRASH_CAPTURE=0            # 关闭自动采集（默认开启）
# AOS_ADB_PATH=                  # 显式指定 adb（默认从 ANDROID_HOME/ANDROID_SDK_ROOT/PATH 解析）
# AOS_CRASH_TIMEOUT_MS=15000     # 单次 adb 采集超时（1000–120000）
# AOS_CRASH_MAX_RECORDS=200      # 崩溃签名记录上限（按最近出现淘汰）

# 设备租约（runner 自动领取时占用设备，30s tick 续租；见 DESIGN.md §13.162）
# 手动 suite run --task 也按 --device 取租约（身份 manual:<taskId>，执行中按 TTL/3 续租，结束释放；见 §13.166）
# AOS_DEVICE_LEASE_MS=90000      # 租约 TTL（非法/≤0 回退 90000；心跳/手动续租间隔自动收敛到 TTL/3）

# 离线取消清扫（runner/HTTP/面板后台每 30s；见 DESIGN.md §13.163）
# AOS_CANCEL_GRACE_MS=90000      # stopping 宽限期（超过且领取机离线 → CAS cancelled；非法/≤0 回退 90000）

# HTTP / 产物服务鉴权（可选静态令牌；见 DESIGN.md §13.113）
# 注意：以下三项只读「进程 env」（serve/runner 进程），不会从项目 .env 生效——列此仅作说明。
# AOS_HTTP_TOKEN=                # serve --http 全路由闸门（Bearer/Basic；GET|HEAD / 与 /healthz 豁免）
# AOS_HTTP_ALLOW_INSECURE=1      # 显式放行「非 loopback 且未设令牌」的 serve（打印醒目 WARN；仅限可信网络）
# AOS_RUNNER_ARTIFACT_TOKEN=     # runner 产物服务 /artifact* 令牌（Bearer/Basic/?t=；/healthz 豁免）

# 说明：MOBILE_TESTING_DATABASE_URL 属于服务级配置，由 MCP 客户端配置的 env 注入，
# 不要写进项目 .env（详见 README / DESIGN.md §4.5）。
